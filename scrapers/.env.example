# Copy to .env (or symlink ../backend/.env). Pydantic loads from cwd when you run from scrapers/.

# Required for fingerprint dedupe + persisting rows to ewura_fuel_observations.
# Use the same Postgres database as the backend (sync URL is derived automatically from +asyncpg).
DATABASE_URL=postgresql+asyncpg://aq_user:change_me@localhost:5432/aq_db

# Celery broker (defaults to redis://localhost:6379/0 if unset).
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
