# Copy to .env (or symlink ../backend/.env). Pydantic loads from cwd when you run from scrapers/.

# Required for fingerprint dedupe + persisting EWURA rows into normalized platform tables.
# Use the same Postgres database as the backend (sync URL is derived automatically from +asyncpg).
DATABASE_URL=postgresql+asyncpg://aq_user:change_me@localhost:5432/aq_db

# Celery broker (defaults to redis://localhost:6379/0 if unset).
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# Slow upstream sites like EWURA may need a longer read timeout in production.
# HTTP_TIMEOUT_SECONDS=120

# NeST PPRA OCDS gateway — default is correct, override only if the gateway URL changes.
# NEST_OCDS_API_URL=https://nest.go.tz/gateway/nest-data-portal-api/api
