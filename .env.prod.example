# Copy this file to .env.prod on the VPS and replace all placeholder values.

COMPOSE_PROJECT_NAME=aq

POSTGRES_USER=aq_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=aq_db
POSTGRES_PORT=5432

# Keep the database and Redis private to Docker. The backend is published only on localhost
# so Nginx on the VPS can proxy to it without exposing the API port publicly.
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8001

DATABASE_URL=postgresql+asyncpg://aq_user:replace_with_a_long_random_password@db:5432/aq_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

SECRET_KEY=replace_with_a_long_random_secret
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://app.abdulqadirmsingi.com

SCRAPER_LOG_LEVEL=INFO
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY=5
